{
  "name": "recipe-sharing-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "node --watch server/index.js",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "npm run test:api && npm run test:jest && npm run test:client",
    "test:api": "node --test server/app.test.js server/database.test.js server/persistence.test.js server/spa.test.js",
    "test:jest": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "test:client": "vitest run",
    "heroku-postbuild": "npm run build"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^12.2.0",
    "cloudinary": "^2.11.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "pg": "^8.23.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-react": "^7.27.1",
    "@testing-library/react": "^16.3.0",
    "@vitejs/plugin-react": "^5.0.2",
    "babel-jest": "^30.1.2",
    "concurrently": "^9.2.1",
    "jest": "^30.1.3",
    "jest-environment-jsdom": "^30.1.2",
    "jsdom": "^26.1.0",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.19.0 <21 || >=22.12.0"
  }
}
